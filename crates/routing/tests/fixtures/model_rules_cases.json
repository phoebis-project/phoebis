{
  "matcher": {
    "a_backslash_quotes_the_next_character": [
      {
        "pattern": "claude\\*",
        "name": "claude*",
        "matches": true
      },
      {
        "pattern": "claude\\*",
        "name": "claude-opus-5",
        "matches": false
      },
      {
        "pattern": "a\\?b",
        "name": "a?b",
        "matches": true
      },
      {
        "pattern": "a\\?b",
        "name": "aXb",
        "matches": false
      },
      {
        "pattern": "a\\\\b",
        "name": "a\\b",
        "matches": true
      }
    ],
    "a_double_star_crosses_slashes": [
      {
        "pattern": "**",
        "name": "a/b/c",
        "matches": true
      },
      {
        "pattern": "**",
        "name": "",
        "matches": true
      },
      {
        "pattern": "**/opus*",
        "name": "vendor/team/opus-5",
        "matches": true
      },
      {
        "pattern": "**a*b",
        "name": "xa/ab",
        "matches": true
      },
      {
        "pattern": "**/opus*",
        "name": "vendor/team/sonnet-5",
        "matches": false
      }
    ],
    "a_pattern_without_a_wildcard_matches_its_own_text_alone": [
      {
        "pattern": "claude-opus-5",
        "name": "claude-opus-5",
        "matches": true
      },
      {
        "pattern": "claude-opus-5",
        "name": "Claude-Opus-5",
        "matches": true
      },
      {
        "pattern": "claude-opus-5",
        "name": "claude-opus-5-1",
        "matches": false
      },
      {
        "pattern": "claude-opus-5",
        "name": "claude-opus",
        "matches": false
      },
      {
        "pattern": "Σ",
        "name": "σ",
        "matches": false
      }
    ],
    "a_question_mark_takes_one_character_other_than_a_slash": [
      {
        "pattern": "claude-opus-?",
        "name": "claude-opus-5",
        "matches": true
      },
      {
        "pattern": "claude-opus-?",
        "name": "claude-opus-",
        "matches": false
      },
      {
        "pattern": "claude-opus-?",
        "name": "claude-opus/",
        "matches": false
      }
    ],
    "a_single_star_stops_at_a_slash": [
      {
        "pattern": "claude-*",
        "name": "claude-opus-5",
        "matches": true
      },
      {
        "pattern": "claude-*",
        "name": "claude-",
        "matches": true
      },
      {
        "pattern": "claude-*",
        "name": "claude-x/y",
        "matches": false
      },
      {
        "pattern": "*",
        "name": "a/b",
        "matches": false
      }
    ]
  },
  "check": [
    {
      "pattern": "",
      "error": "pattern is empty"
    },
    {
      "pattern": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "error": "pattern is longer than 256 characters"
    },
    {
      "pattern": "abc\\",
      "error": "pattern ends in an unquoted backslash"
    },
    {
      "pattern": "abc\\\\",
      "error": null
    },
    {
      "pattern": "a***b",
      "error": "pattern holds three stars in a row"
    },
    {
      "pattern": "a**b",
      "error": null
    },
    {
      "pattern": "a\\***b",
      "error": null
    }
  ],
