{
  "name": "phoebis-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "e2e": "node e2e/views.mjs",
    "preview": "vite preview",
    "smoke": "vite build -c smoke/vite.config.ts && TZ=UTC node smoke/run.mjs",
    "sync-mock": "node scripts/sync-mock.mjs",
    "test": "vite build -c test/vite.config.ts && node --test test/"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "25.0.1",
    "playwright": "1.63.0",
    "typescript": "^5.6.3",
    "vite": "6.4.3"
  }
}
