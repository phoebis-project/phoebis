# Copied to /etc/phoebis/phoebis.env, owned by root, mode 0600; systemd reads it, the service never sees the file.
# Both secrets are required by /etc/phoebis/config.yaml and must differ.
ROUTER_ADMIN_SECRET=replace-with-a-long-random-string
ROUTER_VIEWER_SECRET=replace-with-a-different-long-random-string
RUST_LOG=info
